{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": false,
    "trailingSlash": true,
    "headers": [
      {
        "source": "**/*.@(jpg|jpeg|gif|png|svg|webp|ico|css|js|woff2)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/feed/",
        "destination": "/index.xml",
        "type": 301
      },
      {
        "source": "/feed",
        "destination": "/index.xml",
        "type": 301
      }
    ]
  }
}
